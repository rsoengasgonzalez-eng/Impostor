{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "impostor-party-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "impostor-db",
      "database_id": "77d95115-bbc0-4a0a-8311-d63588c530f0",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "FRONTEND_URL": "https://impostor2.rsoengasgonzalez.workers.dev"
  },

  "observability": {
    "enabled": true
  }
}
