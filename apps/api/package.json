{
  "name": "@impostor/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "check": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply impostor-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply impostor-db --remote"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20251014.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
